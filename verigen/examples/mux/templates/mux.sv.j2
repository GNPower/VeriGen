// -----------------------------------------------------------------------------
// {{ module_name }} -- generated by VeriGen ({{ verigen.name }} v{{ verigen.version }})
// {{ inputs | length }}-input, {{ width }}-bit multiplexer.
// -----------------------------------------------------------------------------
module {{ module_name }} #(
    parameter int WIDTH = {{ width }}
) (
{% for inp in inputs %}
    input  logic [WIDTH-1:0] {{ inp.name }},
{% endfor %}
    input  logic [{{ clog2(inputs | length) - 1 }}:0] sel,
    output logic [WIDTH-1:0] y
);

    always_comb begin
        unique case (sel)
{% for inp in inputs %}
            {{ inputs | length | clog2 }}'d{{ loop.index0 }}: y = {{ inp.name }};
{% endfor %}
            default: y = '0;
        endcase
    end

endmodule
