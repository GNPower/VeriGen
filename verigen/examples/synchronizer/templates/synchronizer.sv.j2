// -----------------------------------------------------------------------------
// {{ module_name }} -- generated by VeriGen ({{ verigen.name }} v{{ verigen.version }})
// {{ width }}-bit, {{ stages }}-stage synchronizer.
// -----------------------------------------------------------------------------
module {{ module_name }} #(
    parameter int WIDTH  = {{ width }},
    parameter int STAGES = {{ stages }}
) (
    input  logic             clk,
{% if include_reset %}
    input  logic             rst_n,
{% endif %}
    input  logic [WIDTH-1:0] async_in,
    output logic [WIDTH-1:0] sync_out
);

    logic [WIDTH-1:0] sync_ff [STAGES];

    always_ff @(posedge clk{% if include_reset %} or negedge rst_n{% endif %}) begin
{% if include_reset %}
        if (!rst_n) begin
            for (int i = 0; i < STAGES; i++) begin
                sync_ff[i] <= {WIDTH{1'b{{ reset_value }}}};
            end
        end else begin
            sync_ff[0] <= async_in;
            for (int i = 1; i < STAGES; i++) begin
                sync_ff[i] <= sync_ff[i-1];
            end
        end
{% else %}
        sync_ff[0] <= async_in;
        for (int i = 1; i < STAGES; i++) begin
            sync_ff[i] <= sync_ff[i-1];
        end
{% endif %}
    end

    assign sync_out = sync_ff[STAGES-1];

endmodule
