// -----------------------------------------------------------------------------
// {{ module_name }} -- generated by VeriGen ({{ verigen.name }} v{{ verigen.version }})
{{ description | comment_block("// ") }}
// Target clock: {{ clk_mhz }} MHz | Implementation: {{ impl }} | Registered: {{ pipelined }}
// -----------------------------------------------------------------------------
module {{ module_name }} #(
    parameter int WIDTH = {{ width }}
) (
    input  logic             clk,
    input  logic [WIDTH-1:0] d,
    output logic [WIDTH-1:0] q
);
{% if pipelined %}
    always_ff @(posedge clk) begin
        q <= d;
    end
{% else %}
    assign q = d;
{% endif %}
endmodule
